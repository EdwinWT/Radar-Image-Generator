            reflectivity_value = segment_data[i+3]\n","            ranges.append(range_value)\n","            bearings.append(bearing_value)\n","            reflectivities.append(reflectivity_value)\n","\n","    return np.array(ranges), np.array(bearings), np.array(reflectivities)\n","\n","# Function to transform data from polar to Cartesian coordinates\n","def transform_data(ranges, bearings, reflectivities):\n","    x = ranges * np.cos(bearings)\n","    y = ranges * np.sin(bearings)\n","    return x, y, reflectivities\n","\n","# Function to create radar image\n","def create_radar_image(x, y, reflectivities, frame_number):\n","    fig, ax = plt.subplots(subplot_kw={'projection': 'polar'})\n","    sc = ax.scatter(y, x, c=reflectivities, cmap='viridis', marker='o')\n","    plt.colorbar(sc, label='Reflectivity')\n","\n","    # Add range rings\n","    for radius in np.arange(0, np.max(x), 100):\n","        ax.plot(np.linspace(0, 2*np.pi, 100), np.full(100, radius), color='white', linestyle='dashed', linewidth=0.5)\n","\n","    # Customize the plot\n","    ax.set_ylim(0, np.max(x))\n","    ax.set_title(f'Marine Radar Image - Frame {frame_number}')\n","    plt.savefig(f'radar_image_frame_{frame_number}.png')\n","    plt.close()\n","\n","# Main function to run the steps\n","def main():\n","    file_path = '/content/drive/MyDrive/COllision/radardata.txt'  # Update with your file path\n","    segments = parse_radar_data(file_path)\n","\n","    for frame_number, segment in enumerate(segments):\n","        ranges, bearings, reflectivities = extract_numeric_data(segment)\n","        x, y, reflectivities = transform_data(ranges, bearings, reflectivities)\n","        create_radar_image(x, y, reflectivities, frame_number)\n","\n","main()\n"],"metadata":{"id":"mR-G_kleMiTn"},"execution_count":null,"outputs":[]}]}